---
interface Props {
	action: string;
}
const { action } = Astro.props;
---

<aside class="action" aria-labelledby="action-title">
	<p id="action-title" class="action__label">今日の一歩</p>
	<p class="action__text">{action}</p>
</aside>

<style>
	.action {
		position: relative;
		padding: var(--spacing-6) var(--spacing-6) var(--spacing-6) calc(var(--spacing-6) + 6px);
		border-radius: var(--radius-xl);
		background: var(--color-accent-soft);
		overflow: hidden;
	}

	.action::before {
		content: "";
		position: absolute;
		inset: 0 auto 0 0;
		width: 6px;
		background: var(--color-accent);
	}

	.action__label {
		font-family: var(--font-mono);
		font-size: var(--font-size-label);
		font-weight: 500;
		letter-spacing: var(--tracking-wider);
		color: var(--color-accent-ink);
	}

	.action__text {
		margin-top: var(--spacing-2);
		font-size: var(--font-size-lg);
		font-weight: 600;
		line-height: 1.7;
		color: var(--color-text);
	}
</style>
